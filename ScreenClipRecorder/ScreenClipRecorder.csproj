<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ScreenClipRecorder.ico</ApplicationIcon>
    <AssemblyName>ScreenClipRecorder</AssemblyName>
    <RootNamespace>ScreenClipRecorder</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ScreenRecorderLib" Version="6.6.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\ScreenClipRecorder.ico" />
    <Resource Include="Assets\ScreenClipRecorder.png" />
  </ItemGroup>
</Project>
