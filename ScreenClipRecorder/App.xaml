<Application x:Class="ScreenClipRecorder.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#4F6BED" />
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="7" /></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="6" /></Style>
  </Application.Resources>
</Application>
