<Window x:Class="ScreenClipRecorder.RegionSelectorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="#66000000" Topmost="True"
 ShowInTaskbar="False" Cursor="Cross" KeyDown="OnKeyDown" MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseUp">
 <Canvas x:Name="Surface">
  <Rectangle x:Name="Selection" Visibility="Collapsed" Stroke="#4F8CFF" StrokeThickness="2" Fill="#18FFFFFF" />
  <Border x:Name="SizeBadge" Visibility="Collapsed" Background="#E61F1F1F" CornerRadius="5" Padding="8,4">
   <TextBlock x:Name="SizeText" Foreground="White" FontWeight="SemiBold" />
  </Border>
  <Border Canvas.Left="20" Canvas.Top="20" Background="#E61F1F1F" CornerRadius="7" Padding="12,8">
   <TextBlock Foreground="White" Text="드래그하여 영역 선택  ·  Enter 확정  ·  Esc 취소" />
  </Border>
 </Canvas>
</Window>
