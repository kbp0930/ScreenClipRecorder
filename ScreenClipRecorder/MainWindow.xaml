<Window x:Class="ScreenClipRecorder.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ScreenClip Recorder" Icon="Assets/ScreenClipRecorder.ico" Width="720" Height="680" MinWidth="680" MinHeight="620" WindowStartupLocation="CenterScreen" Background="#F5F6FA">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,20"><TextBlock FontSize="25" FontWeight="Bold" Text="ScreenClip Recorder"/><TextBlock Margin="0,6,0,0" Foreground="#666" Text="선택한 화면 영역과 시스템 소리만 MP4로 녹화합니다."/></StackPanel>
  <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,12"><Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock FontWeight="SemiBold" Text="녹화 영역"/><TextBlock x:Name="RegionText" Margin="0,7,0,0" Foreground="#666" Text="영역을 먼저 선택하세요"/></StackPanel>
   <Button Grid.Column="1" Click="SelectRegion_Click" Content="영역 선택"/>
  </Grid></Border>
  <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,12"><Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
   <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="화질 프리셋"/><ComboBox x:Name="PresetBox" Grid.Column="1" SelectionChanged="Settings_Changed"/>
   <TextBlock Grid.Row="1" Margin="0,16,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="예상 파일 크기"/><TextBlock x:Name="EstimateText" Grid.Row="1" Grid.Column="1" Margin="0,16,0,0" Foreground="#4F6BED" FontWeight="SemiBold"/>
   <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0" Foreground="#777" TextWrapping="Wrap" Text="H.264 하드웨어 인코딩 · AAC 시스템 오디오 · 화면 변화가 적으면 실제 용량은 더 작아질 수 있습니다."/>
  </Grid></Border>
  <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,12"><Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
   <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="저장 위치"/><TextBox x:Name="SaveFolderText" Grid.Column="1" Margin="0,0,8,0"/><Button Grid.Column="2" Margin="0" Click="Browse_Click" Content="찾아보기"/>
   <TextBlock Grid.Row="1" Margin="0,15,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="자동 종료"/>
   <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,15,0,0" Orientation="Horizontal">
    <CheckBox x:Name="AutoStopCheck" VerticalAlignment="Center" Checked="Settings_Changed" Unchecked="Settings_Changed" Content="사용"/>
    <TextBox x:Name="HoursText" Width="42" Margin="14,0,4,0" Text="0" TextChanged="Settings_Changed"/><TextBlock VerticalAlignment="Center" Text="시간"/>
    <TextBox x:Name="MinutesText" Width="42" Margin="10,0,4,0" Text="30" TextChanged="Settings_Changed"/><TextBlock VerticalAlignment="Center" Text="분"/>
    <TextBox x:Name="SecondsText" Width="42" Margin="10,0,4,0" Text="0" TextChanged="Settings_Changed"/><TextBlock VerticalAlignment="Center" Text="초"/>
   </StackPanel>
   <TextBlock Grid.Row="2" Margin="0,15,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="시작 지연"/>
   <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,15,0,0" Orientation="Horizontal">
    <ComboBox x:Name="DelayBox" Width="120"><ComboBoxItem Tag="0" Content="없음"/><ComboBoxItem Tag="3" Content="3초"/><ComboBoxItem Tag="5" Content="5초"/><ComboBoxItem Tag="10" Content="10초"/></ComboBox>
    <CheckBox x:Name="CursorCheck" Margin="22,0,0,0" VerticalAlignment="Center" IsChecked="True" Content="마우스 커서 포함"/>
   </StackPanel>
  </Grid></Border>
  <Border Grid.Row="4" Background="#EEF1FF" CornerRadius="10" Padding="16" Margin="0,0,0,12"><TextBlock TextWrapping="Wrap" Foreground="#4B5685" Text="단축키  Ctrl+Shift+R 시작 · Ctrl+Shift+P 일시정지/재개 · Ctrl+Shift+S 중지"/></Border>
  <StackPanel Grid.Row="5" HorizontalAlignment="Center" Orientation="Horizontal" Margin="0,6"><Button x:Name="StartButton" Width="150" Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold" Click="Start_Click" Content="녹화 시작"/><Button x:Name="PauseButton" Width="130" IsEnabled="False" Click="Pause_Click" Content="일시정지"/><Button x:Name="StopButton" Width="100" IsEnabled="False" Click="Stop_Click" Content="중지"/></StackPanel>
  <Border Grid.Row="6" Background="#1F1F1F" CornerRadius="9" Padding="15" Margin="0,10,0,0"><Grid><TextBlock x:Name="StatusText" Foreground="White" Text="준비됨"/><TextBlock x:Name="ElapsedText" HorizontalAlignment="Right" Foreground="#8FB0FF" FontFamily="Consolas" FontSize="16" Text="00:00:00"/></Grid></Border>
 </Grid></ScrollViewer>
</Window>
